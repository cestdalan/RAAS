# ========================================================
# CLOUDFLARE PAGES ENVIRONMENT VARIABLES
# Set these in Cloudflare Dashboard:
# Workers & Pages > Your Project > Settings > Variables and Secrets
# ========================================================

# 1. Build Runner Configuration
NODE_VERSION=20
NPM_FLAGS=--no-audit --no-fund

# 2. Application Client Configuration (Exposed to Vite)
VITE_APP_NAME="ART GALLERY (AG)"
VITE_APP_TITLE="Heritage In Art — ART GALLERY (AG)"
VITE_CONTACT_EMAIL="inquire@artgallery.com"
VITE_GALLERY_LOCATION="18 Place Vendôme, 75001 Paris"
VITE_CURATION_YEAR="2026"
